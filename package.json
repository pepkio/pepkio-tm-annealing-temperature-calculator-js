{
  "name": "pepkio-tm-annealing-temperature-calculator",
  "version": "0.1.0",
  "description": "JavaScript and TypeScript client for batch and single-primer Tm/Ta calculations via the Pepkio REST API, with CLI.",
  "license": "MIT",
  "author": "Pepkio Team",
  "homepage": "https://www.pepkio.com/tools/tm-annealing-temperature-calculator",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pepkio/pepkio-tm-annealing-temperature-calculator-js.git"
  },
  "bugs": {
    "url": "https://github.com/pepkio/pepkio-tm-annealing-temperature-calculator-js/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "keywords": [
    "primer-tm",
    "melting-temperature",
    "annealing-temperature",
    "pcr",
    "pcr-primer",
    "santa-lucia",
    "nearest-neighbor",
    "delta-tm",
    "q5",
    "phusion",
    "taq",
    "kapa-hifi",
    "dmso",
    "betaine",
    "multiplex-pcr",
    "primer-qc",
    "hairpin",
    "dimer",
    "batch-primer",
    "pepkio",
    "laboratory-calculator",
    "bioinformatics",
    "life-sciences",
    "typescript",
    "node",
    "rest-api",
    "scientific-computing"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "pepkio-tm-annealing-temperature-calculator": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run test/client.test.ts",
    "test:integration": "vitest run test/integration.test.ts",
    "test:all": "vitest run"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "undici": "^7.27.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "dotenv": "^17.4.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.6"
  }
}
