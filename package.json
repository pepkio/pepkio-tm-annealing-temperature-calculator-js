{
  "name": "pepkio-tm-annealing-temperature-calculator",
  "version": "0.1.0",
  "description": "TypeScript client for the Pepkio Tm / Annealing Temperature Calculator REST API.",
  "license": "MIT",
  "author": "Pepkio Team",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "pepkio-tm-annealing-temperature-calculator": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run test/client.test.ts",
    "test:integration": "vitest run test/integration.test.ts",
    "test:all": "vitest run"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "undici": "^7.27.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "dotenv": "^17.4.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.6"
  }
}
